# Generated code
/telethon/tl/functions/
/telethon/tl/types/
/telethon/tl/alltlobjects.py
/telethon/errors/rpcerrorlist.py

# User session
*.session
/sessions/
/usermedia/

# Local env / secrets
.env
.env.*

# Superflow runtime state (per-repo)
.superflow-state.json

# Builds and testing
__pycache__/
/dist/
/build/
/*.egg-info/
/readthedocs/_build/
/.tox/

# API reference docs
/docs/

# File used to manually test new changes, contains sensitive data
/example.py

# MCP bridge runtime artifacts
*.key.enc
mcp_bridge_config.toml
downloads/
*.log
.coverage
htmlcov/

# Worktrees (managed by git-worktree, not tracked)
.worktrees/

# Exception: docs/ subdirectories that are committed (not Sphinx build output)
!docs/
# Exception: MCP bridge evidence & runbooks
!docs/mcp_bridge/
!docs/mcp_bridge/**
# Exception: Superflow plans/specs/health report (committed governance docs)
!docs/superflow/
!docs/superflow/**
# Exception: Superpowers plans (committed governance docs)
!docs/superpowers/
!docs/superpowers/**
# Exception: Archived security reference docs
!docs/security/
!docs/security/**
# Exception: Upstream sync procedure
!docs/UPSTREAM_SYNC.md
.par-evidence.json
